{
  "$schema": "https://opencode.ai/config.json",
  "agents": {
    "explore": {
      "model": "opencode-go/muse-spark-1.3-contributor#high",
      "description": "Use for tracing behavior, dependencies, and likely causes across files without edits. Prefer runner for bounded factual lookups."
    },
    "general": {
      "model": "opencode-go/deepseek-v4.1-flash#max",
      "description": "Use for bounded mixed investigation and implementation when no specialist fits. Prefer fixer for defined changes and explore for read-only tracing."
    }
  }
}
